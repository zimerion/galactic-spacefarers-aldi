{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "paths": {
      "#cds-models/*": [
        "./@cds-models/*"
      ]
    },
    "types": [
      "node",
      "@cap-js/cds-types"
    ],
    "noEmit": true
  },
  "exclude": [
    "gen",
    "app"
  ]
}
