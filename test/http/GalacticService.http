@server=http://localhost:4004

### Anonymous request is rejected with 401
GET {{server}}/galactic/Spacefarers


### User without a role is rejected with 403
GET {{server}}/galactic/Spacefarers
Authorization: Basic intruder:


### Commander of Milsani Way sees only Milsani spacefarers
GET {{server}}/galactic/Spacefarers?$expand=originPlanet,spacesuitColor,position
Authorization: Basic nova:


### Viewer of Moser Roth sees only Moser Roth spacefarers
GET {{server}}/galactic/Spacefarers
Authorization: Basic luna:


### Commander of the empty planet Tandil sees nobody
GET {{server}}/galactic/Spacefarers
Authorization: Basic tandil:


### Spacefarer of another planet is not found
GET {{server}}/galactic/Spacefarers(147200a1-4ded-4dee-8a5b-9613b72d2636)
Authorization: Basic nova:


### Commander enlists a spacefarer on their own planet
# @name enlist
POST {{server}}/galactic/Spacefarers
Content-Type: application/json
Authorization: Basic nova:

{
  "firstName": "Kira",
  "lastName": "Comet",
  "email": "kira.comet@galaxy.test",
  "stardustCollection": 1200,
  "wormholeNavigationSkill": 4,
  "originPlanet_code": "MILSANI",
  "IsActiveEntity": true,
  "spacesuitColor_code": "SKY",
  "position_ID": "231ebbf0-0a0d-4451-a06c-789251d68e4f"
}


### Commander updates the new spacefarer
PATCH {{server}}/galactic/Spacefarers({{enlist.response.body.$.ID}})
Content-Type: application/json
Authorization: Basic nova:

{
  "stardustCollection": 5200
}


### Commander removes the new spacefarer
DELETE {{server}}/galactic/Spacefarers({{enlist.response.body.$.ID}})
Authorization: Basic nova:


### Commander cannot enlist on another planet
POST {{server}}/galactic/Spacefarers
Content-Type: application/json
Authorization: Basic nova:

{
  "firstName": "Sneaky",
  "lastName": "Spy",
  "email": "sneaky.spy@galaxy.test",
  "originPlanet_code": "MOSERROTH",
  "IsActiveEntity": true
}


### Viewer cannot write
PATCH {{server}}/galactic/Spacefarers(147200a1-4ded-4dee-8a5b-9613b72d2636)
Content-Type: application/json
Authorization: Basic luna:

{
  "stardustCollection": 0
}


### Associations of a spacefarer from another planet are not found
GET {{server}}/galactic/Spacefarers(147200a1-4ded-4dee-8a5b-9613b72d2636)/originPlanet
Authorization: Basic nova:


### Commander cannot move a spacefarer to another planet
PATCH {{server}}/galactic/Spacefarers(04ae85f9-b0f3-48e8-bf63-1136711c9062)
Content-Type: application/json
Authorization: Basic nova:

{
  "originPlanet_code": "MOSERROTH"
}


### E-mail addresses are unique across all planets
POST {{server}}/galactic/Spacefarers
Content-Type: application/json
Authorization: Basic tandil:

{
  "firstName": "Luna",
  "lastName": "Twin",
  "email": "luna.csillag@galaxy.test",
  "originPlanet_code": "TANDIL",
  "IsActiveEntity": true
}


### Value lists are readable for viewers and commanders
GET {{server}}/galactic/Positions?$expand=department
Authorization: Basic luna:


### Value lists are not readable without a role
GET {{server}}/galactic/Positions
Authorization: Basic intruder:


### Candidate gets the minimum skill of the position, a launch bonus of 50 stardust per skill level and a welcome e-mail (see the server console)
POST {{server}}/galactic/Spacefarers
Content-Type: application/json
Authorization: Basic nova:

{
  "firstName": "Mira",
  "lastName": "Nebula",
  "email": "mira.nebula@galaxy.test",
  "stardustCollection": 100,
  "originPlanet_code": "MILSANI",
  "IsActiveEntity": true,
  "position_ID": "231ebbf0-0a0d-4451-a06c-789251d68e4f"
}


### Candidate below the skill minimum of the position is rejected
POST {{server}}/galactic/Spacefarers
Content-Type: application/json
Authorization: Basic nova:

{
  "firstName": "Rookie",
  "lastName": "Pilot",
  "email": "rookie.pilot@galaxy.test",
  "wormholeNavigationSkill": 3,
  "originPlanet_code": "MILSANI",
  "IsActiveEntity": true,
  "position_ID": "c8786d2d-05c9-49bc-86ea-769378e7955a"
}


### List report query: medium stardust status, sorted by stardust, second page of one
GET {{server}}/galactic/Spacefarers?$filter=stardustStatus eq 'MEDIUM'&$orderby=stardustCollection desc&$top=1&$skip=1&$count=true&$expand=stardustLevel,spacesuitColor
Authorization: Basic luna:


### Object page: commander starts editing an own spacefarer (draft)
POST {{server}}/galactic/Spacefarers(ID=04ae85f9-b0f3-48e8-bf63-1136711c9062,IsActiveEntity=true)/GalacticService.draftEdit
Content-Type: application/json
Authorization: Basic nova:

{
  "PreserveChanges": true
}


### Object page: commander changes the stardust collection and the spacesuit color in the draft
PATCH {{server}}/galactic/Spacefarers(ID=04ae85f9-b0f3-48e8-bf63-1136711c9062,IsActiveEntity=false)
Content-Type: application/json
Authorization: Basic nova:

{
  "stardustCollection": 500,
  "spacesuitColor_code": "SKY"
}


### Object page: commander saves the draft
POST {{server}}/galactic/Spacefarers(ID=04ae85f9-b0f3-48e8-bf63-1136711c9062,IsActiveEntity=false)/GalacticService.draftActivate
Content-Type: application/json
Authorization: Basic nova:

{}


### Object page: commander discards the draft instead of saving it
DELETE {{server}}/galactic/Spacefarers(ID=04ae85f9-b0f3-48e8-bf63-1136711c9062,IsActiveEntity=false)
Authorization: Basic nova:


### Object page: commander creates a new draft, the origin planet defaults to their own
# @name newDraft
POST {{server}}/galactic/Spacefarers
Content-Type: application/json
Authorization: Basic nova:

{}


### Object page: picking a position raises the skill to its minimum
PATCH {{server}}/galactic/Spacefarers(ID={{newDraft.response.body.$.ID}},IsActiveEntity=false)
Content-Type: application/json
Authorization: Basic nova:

{
  "firstName": "Vega",
  "lastName": "Draft",
  "email": "vega.draft@galaxy.test",
  "position_ID": "c8786d2d-05c9-49bc-86ea-769378e7955a"
}


### Object page: saving the new draft adds the launch bonus and sends the welcome e-mail
POST {{server}}/galactic/Spacefarers(ID={{newDraft.response.body.$.ID}},IsActiveEntity=false)/GalacticService.draftActivate
Content-Type: application/json
Authorization: Basic nova:

{}


### Object page: Create, Edit and Delete are shown only to commanders
GET {{server}}/galactic/Configuration
Authorization: Basic luna:


### Object page: viewer cannot edit
POST {{server}}/galactic/Spacefarers(ID=147200a1-4ded-4dee-8a5b-9613b72d2636,IsActiveEntity=true)/GalacticService.draftEdit
Content-Type: application/json
Authorization: Basic luna:

{
  "PreserveChanges": true
}
