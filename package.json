{
  "name": "galactic-spacefarer",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/cds-typer": "^0.41.1",
    "@cap-js/cds-types": "^0.20.0",
    "@cap-js/sqlite": "^3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "tsx": "^4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "lint": "eslint .",
    "typecheck": "cds-typer \"*\" && tsc --noEmit"
  },
  "private": true,
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
