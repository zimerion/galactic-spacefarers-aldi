{
  "name": "galactic-spacefarer",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-typer": "^0.41.1",
    "@cap-js/cds-types": "^0.20.0",
    "@cap-js/sqlite": "^3",
    "@eslint/js": "^10.0.1",
    "@sap/cds-dk": "^10.1.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "tsx": "^4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "lint": "eslint .",
    "typecheck": "cds-typer \"*\" && tsc --noEmit",
    "pretest": "cds-typer \"*\"",
    "test": "node --import tsx --import ./test/setup.ts --test \"test/**/*.test.ts\""
  },
  "private": true,
  "cds": {
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "nova": {
              "roles": [
                "Commander"
              ],
              "attr": {
                "planet": [
                  "MILSANI"
                ]
              }
            },
            "luna": {
              "roles": [
                "Viewer"
              ],
              "attr": {
                "planet": [
                  "MOSERROTH"
                ]
              }
            },
            "tandil": {
              "roles": [
                "Commander"
              ],
              "attr": {
                "planet": "TANDIL"
              }
            },
            "intruder": {},
            "*": false
          }
        }
      },
      "[production]": {
        "auth": "xsuaa"
      }
    }
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
